APP_ENV=development
DATABASE_URL=sqlite:///./proofmint.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
RECEIPT_SIGNING_SECRET=replace-with-a-random-32-byte-or-longer-secret
MAX_VIDEO_MB=100
UPLOAD_DIR=./uploads
MOMENTWEAVE_EXPORT_DIR=./momentweave_exports

# Phase 3: Whisper CPU recognition (model downloads on first use)
WHISPER_MODEL=tiny.en

# Required on Render production only (do not commit the actual token)
DEMO_UPLOAD_TOKEN=
MAX_VIDEO_SECONDS=3600
